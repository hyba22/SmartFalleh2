import { FiEdit2, FiTrash2, FiEye, FiAlertCircle, FiLoader } from 'react-icons/fi';
import { Table } from '../layout/Table';
import type { Column } from '../layout/Table';
import React, { useEffect, useState } from 'react';
import { getAllUsers } from '../../services/adminService';

// Define your data type
type User = {
  id: string;
  name: string;
  email: string;
  role: string;
  region: string;
  agglomeration: string;
  status?: 'active' | 'inactive' | 'pending';
  lastLogin?: string;
  avatar?: string;
};

// Define the API user type that matches your backend response
type ApiUser = {
  _id: string;
  nom: string;
  prenom: string;
  email: string;
  role: string;
  region: string;
  agglomeration: string;
  status?: 'active' | 'inactive' | 'pending';
  lastLogin?: string;
  avatar?: string;
};

// Map API user to local User type
const mapApiUserToLocal = (apiUser: ApiUser): User => ({
  id: apiUser._id,
  name: `${apiUser.prenom} ${apiUser.nom}`,
  email: apiUser.email,
  role: apiUser.role,
  region: apiUser.region,
  agglomeration: apiUser.agglomeration,
  status: apiUser.status || 'inactive',
  lastLogin: apiUser.lastLogin,
  avatar: apiUser.avatar,
});

// Define columns with proper typing
const columns: Column<User>[] = [
  {
    header: 'Nom',
    accessor: (user: User) => user.name.split(' ')[1] || user.name,
    sortable: true,
  },
  {
    header: 'Prénom',
    accessor: (user: User) => user.name.split(' ')[0],
    sortable: true,
  },
  {
    header: 'Email',
    accessor: (user: User) => user.email,
    sortable: true,
  },
  {
    header: 'Région',
    accessor: (user: User) => user.region,
    sortable: true,
  },
  {
    header: 'Agglomération',
    accessor: (user: User) => user.agglomeration,
    sortable: true,
  },
  {
    header: 'Rôle',
    accessor: (user: User) => user.role,
    sortable: true,
  },
  {
    header: 'Statut',
    accessor: (user: User) => (
      <span className={`px-2 py-1 rounded-full text-xs ${
        user.status === 'active' ? 'bg-green-100 text-green-800' :
        user.status === 'inactive' ? 'bg-red-100 text-red-800' :
        'bg-yellow-100 text-yellow-800'
      }`}>
        {user.status || 'inactive'}
      </span>
    ),
    sortable: true,
  },
  {
    header: 'Actions',
    accessor: (user: User) => (
      <div className="flex gap-2">
        <button 
          className="bg-blue-500 hover:bg-blue-600 text-white p-2 rounded-full"
          onClick={(e) => {
            e.stopPropagation();
            // Handle view action
          }}
        >
          <FiEye className="w-4 h-4" />
        </button>
        <button 
          className="bg-yellow-500 hover:bg-yellow-600 text-white p-2 rounded-full"
          onClick={(e) => {
            e.stopPropagation();
            // Handle edit action
          }}
        >
          <FiEdit2 className="w-4 h-4" />
        </button>
        <button 
          className="bg-red-500 hover:bg-red-600 text-white p-2 rounded-full"
          onClick={(e) => {
            e.stopPropagation();
            // Handle delete action
          }}
        >
          <FiTrash2 className="w-4 h-4" />
        </button>
      </div>
    ),
  },
];

const UserList = () => {
  const [users, setUsers] = useState<User[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    const fetchUsers = async () => {
      try {
        setIsLoading(true);
        const data = await getAllUsers();
        // Map the API response to match our User type
        const mappedUsers = data.map((user: ApiUser) => mapApiUserToLocal(user));
        setUsers(mappedUsers);
        setError(null);
      } catch (err) {
        console.error('Failed to fetch users:', err);
        setError(err instanceof Error ? err.message : 'Failed to load users');
      } finally {
        setIsLoading(false);
      }
    };

    fetchUsers();
  }, []);

  const handleRowClick = (user: User) => {
    // Handle row click if needed
    console.log('User clicked:', user);
  };

  if (isLoading) {
    return (
      <div className="flex items-center justify-center h-64">
        <FiLoader className="animate-spin text-blue-500 text-2xl mr-2" />
        <span>Chargement des utilisateurs...</span>
      </div>
    );
  }

  if (error) {
    return (
      <div className="bg-red-50 border-l-4 border-red-500 p-4 m-6">
        <div className="flex">
          <div className="flex-shrink-0">
            <FiAlertCircle className="h-5 w-5 text-red-500" />
          </div>
          <div className="ml-3">
            <p className="text-sm text-red-700">{error}</p>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="p-6">
      <div className="flex justify-between items-center mb-6">
        <h1 className="text-2xl font-bold">Liste des Utilisateurs</h1>
      </div>
      <div className="bg-white rounded-lg shadow overflow-hidden">
        <Table 
          data={users} 
          columns={columns} 
          pageSize={10} 
          onRowClick={handleRowClick} 
          searchable={true} 
          searchPlaceholder="Rechercher des utilisateurs..."
          className="min-w-full divide-y divide-gray-200"
        />
      </div>
    </div>
  );
};

export default UserList;
